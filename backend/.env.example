# Weather API - Get from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Satellite Data API - Get from https://apps.sentinel-hub.com/
SENTINELHUB_CLIENT_ID=your_sentinelhub_client_id
SENTINELHUB_CLIENT_SECRET=your_sentinelhub_client_secret

# AI Chat API - Get from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key

# Gemini AI API - Get from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key