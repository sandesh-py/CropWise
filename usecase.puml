@startuml
left to right direction
skinparam usecase {
BackgroundColor #f9f9f9
BorderColor #3b6ea5
ArrowColor #2e3a59
}
skinparam actorStyle awesome
skinparam shadowing false


actor Farmer
actor Agronomist
actor Administrator as Admin
actor "External Data Services" as External


rectangle "CropWise System" {
(Input Farm Details) as UC1
(Upload Crop or Soil Data) as UC2
(Predict Crop Yield) as UC3
(View Recommendations) as UC4
(Explain Predictions) as UC5
(Expert Feedback) as UC6
(Manage System and Data) as UC7
(Integrate External Data) as UC8
}


Farmer -- UC1
Farmer -- UC2
Farmer -- UC3
Farmer -- UC4
Farmer -- UC5


Agronomist -- UC3
Agronomist -- UC5
Agronomist -- UC6


Admin -- UC7
Admin -- UC8


External --> UC8


UC3 ..> UC8 : <<includes>>
UC5 ..> UC3 : <<extends>>


@enduml